<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIAttributes.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Pages.CartPage"
             x:DataType="vm:MainViewModel"
             Title="Cart"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">

    <Grid SafeAreaEdges="None">
        <views:ShoppingListView />

        <!-- Dismiss button overlay — positioned in the cart's green header area -->
        <Border HorizontalOptions="End" VerticalOptions="Start"
                BackgroundColor="Transparent" StrokeThickness="0"
                SafeAreaEdges="Container"
                Padding="8,4" Margin="4">
            <Button Text="&#xF36A;"
                    FontFamily="FluentFilled"
                    FontSize="{StaticResource FontSizeSubtitle}"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    Padding="8,4"
                    Clicked="OnCloseClicked" />
        </Border>
    </Grid>

</ContentPage>
