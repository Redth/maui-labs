<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:AIAttributes.Sample.Garden"
       x:Class="AIAttributes.Sample.Garden.AppShell"
       Title="Garden Shop"
       Shell.FlyoutBehavior="Flyout"
       Shell.BackgroundColor="#5B8C5A"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       FlyoutBackgroundColor="#E0EBDD">

    <FlyoutItem Title="🛒 Shop" Route="shop">
        <ShellContent
            Title="Garden AI Chat"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="📦 Orders" Route="orders">
        <ShellContent
            Title="Past Orders"
            ContentTemplate="{DataTemplate pages:OrdersPage}"
            Route="OrdersPage" />
    </FlyoutItem>

</Shell>
