<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIAttributes.Sample.Garden.MainPage"
             x:Name="ThisPage"
             Title="Garden AI Chat"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">

        <!-- Main chat column -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="0">

            <!-- Header -->
            <Border Grid.Row="0"
                    BackgroundColor="#5B8C5A"
                    Padding="16,14"
                    StrokeThickness="0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="🌿 Garden AI"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="White" VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="New Chat"
                            AutomationId="NewChatButton"
                            Clicked="OnNewChatClicked"
                            BackgroundColor="#E3F2E3"
                            TextColor="#5B8C5A"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            Padding="12,6"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Chat Messages -->
            <ScrollView Grid.Row="1"
                        x:Name="ChatScrollView"
                        Padding="12,8">
                <VerticalStackLayout x:Name="MessagesStack"
                                     Spacing="8" />
            </ScrollView>

            <!-- Input Area -->
            <Grid x:Name="InputArea"
                  Grid.Row="2"
                  Padding="12,8,12,12"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">
                <Entry x:Name="ChatInput"
                       AutomationId="ChatInput"
                       Placeholder="Ask about plants..."
                       ReturnType="Send"
                       Completed="OnSendClicked"
                       FontSize="14" />
                <Button Grid.Column="1"
                        Text="Send"
                        AutomationId="SendButton"
                        Clicked="OnSendClicked"
                        BackgroundColor="#5B8C5A"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="8"
                        Padding="16,8"
                        VerticalOptions="Center" />
            </Grid>

            <!-- Approval Area (hidden by default) -->
            <Grid x:Name="ApprovalArea"
                  Grid.Row="2"
                  Padding="12,8,12,12"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8"
                  IsVisible="False"
                  BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3E3520}">
                <Label x:Name="ApprovalLabel"
                       Text="Approve tool call?"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <Button Grid.Column="1"
                        Text="✅ Approve"
                        AutomationId="ApproveButton"
                        Clicked="OnApproveClicked"
                        BackgroundColor="#5B8C5A"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="8"
                        Padding="16,8"
                        VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="❌ Reject"
                        AutomationId="RejectButton"
                        Clicked="OnRejectClicked"
                        BackgroundColor="#C62828"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="8"
                        Padding="16,8"
                        VerticalOptions="Center" />
            </Grid>

        </Grid>

        <!--
             Garden side panel.
             Bound to the scoped GardenService instance for the current chat
             session. Clears when New Chat creates a new DI scope, making the
             scoped-lifetime story visible at runtime.
        -->
        <Border Grid.Column="1"
                WidthRequest="260"
                BackgroundColor="{AppThemeBinding Light=#F0F7EF, Dark=#1A241A}"
                Stroke="{AppThemeBinding Light=#D0E0CF, Dark=#2A3A2A}"
                StrokeThickness="0,0,0,0"
                Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        BackgroundColor="#5B8C5A"
                        Padding="14,12"
                        StrokeThickness="0">
                    <Label Text="🌱 Your Garden"
                           TextColor="White"
                           FontSize="14"
                           FontAttributes="Bold" />
                </Border>
                <CollectionView Grid.Row="1"
                                x:Name="GardenList"
                                AutomationId="GardenList"
                                Margin="0,4,0,0">
                    <CollectionView.EmptyView>
                        <Label Text="No plants yet. Ask the assistant to add some."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#7A8A7A, Dark=#8AA08A}"
                               Padding="14,20"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10,4"
                                    Padding="10,8"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#263026}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Nickname}"
                                           FontAttributes="Bold"
                                           FontSize="13" />
                                    <Label Text="{Binding Species}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#5B8C5A, Dark=#8FBF8F}" />
                                    <Label Text="{Binding Location, StringFormat='📍 {0}'}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#888, Dark=#AAA}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
