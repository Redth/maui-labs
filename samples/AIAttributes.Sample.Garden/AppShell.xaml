<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:AIAttributes.Sample.Garden.Pages"
       x:Class="AIAttributes.Sample.Garden.AppShell"
       Title="Garden Shop"
       Shell.BackgroundColor="#5B8C5A"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.NavBarIsVisible="False">

    <!-- Single main page — responsive layout adapts to window width -->
    <ShellContent Route="main"
                  ContentTemplate="{DataTemplate pages:MainPage}"
                  Shell.TabBarIsVisible="False" />

</Shell>
