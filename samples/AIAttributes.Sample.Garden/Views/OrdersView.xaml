<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Views.OrdersView"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{AppThemeBinding Light=#E0EBDD, Dark=#15201A}">

    <Grid RowDefinitions="40,*">

        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light=#3A5A3A, Dark=#1F3320}"
                StrokeThickness="0"
                Padding="16,0">
            <Label Text="📦 Past Orders"
                   FontSize="14" FontAttributes="Bold"
                   TextColor="White" VerticalOptions="Center" />
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding PastOrders}"
                        SelectionMode="None"
                        Margin="10,10">
            <CollectionView.EmptyView>
                <Label Text="No past orders yet. Check out a list to see it here."
                       FontSize="11"
                       FontAttributes="Italic"
                       TextColor="{AppThemeBinding Light=#7A8A7A, Dark=#6A8068}"
                       Padding="4,2" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:OrderViewModel">
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#243024}"
                            Stroke="{AppThemeBinding Light=#D5E5D2, Dark=#3A4A38}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Margin="0,2"
                            Padding="10,6">
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding PlacedAt}" FontSize="11" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Total}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#3A5A3A, Dark=#B4D4B4}" />
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OrderLineViewModel">
                                        <Label Text="{Binding Line}" FontSize="10"
                                               TextColor="{AppThemeBinding Light=#5A6A5A, Dark=#8AA08A}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
