<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIAttributes.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.OrdersPage"
             x:DataType="vm:MainViewModel"
             Title="Past Orders"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="56,*">
        <!-- Modal header with close button -->
        <Border Grid.Row="0"
                BackgroundColor="#5B8C5A"
                StrokeThickness="0"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="✕"
                        FontSize="18"
                        Padding="8,4"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        VerticalOptions="Center"
                        Clicked="OnCloseClicked" />
                <Label Grid.Column="1"
                       Text="Past Orders"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </Grid>
        </Border>

        <views:OrdersView Grid.Row="1" />
    </Grid>

</ContentPage>
