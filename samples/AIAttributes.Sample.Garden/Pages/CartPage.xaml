<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIAttributes.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Pages.CartPage"
             x:DataType="vm:MainViewModel"
             Title="Cart"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="Auto,*">
        <!-- Safe area spacer — colored green to match cart header -->
        <BoxView Grid.Row="0"
                 BackgroundColor="{StaticResource Primary}"
                 SafeAreaEdges="Container"
                 HeightRequest="0" />

        <!-- Cart content with close button overlay -->
        <Grid Grid.Row="1">
            <views:ShoppingListView />

            <!-- Close button overlay — top-left over the cart's green header -->
            <Button Text="&#xF36A;"
                    FontFamily="FluentFilled"
                    FontSize="{StaticResource FontSizeSubtitle}"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    Padding="8,4"
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="8,10"
                    Clicked="OnCloseClicked" />
        </Grid>
    </Grid>

</ContentPage>
