<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Views.ShoppingListView"
             x:DataType="vm:MainViewModel"
             BackgroundColor="Transparent">

    <!-- Floating bubble card with rounded corners and shadow -->
    <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
            StrokeShape="RoundRectangle 16"
            Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
            StrokeThickness="1">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.12" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

            <!-- Cart header -->
            <Grid Padding="16,14"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  BackgroundColor="{StaticResource Primary}">
                <Label VerticalOptions="Center"
                       FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="&#xF26B; "
                                  FontFamily="FluentFilled"
                                  FontSize="{StaticResource FontSizeSubtitle}" />
                            <Span Text="Cart" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Border Grid.Column="2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PillBackgroundLight}, Dark={StaticResource PillBackgroundDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 13"
                        Padding="0"
                        HeightRequest="26">
                    <Button Text="{Binding CartModeLabel}"
                            FontSize="{StaticResource FontSizeCaption}" Padding="14,0"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                            FontAttributes="Bold"
                            BorderWidth="0"
                            VerticalOptions="Center"
                            Command="{Binding CycleCartModeCommand}" />
                </Border>
            </Grid>

            <!-- Normal mode: card layout -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding ShoppingList}"
                            SelectionMode="None"
                            Margin="0,8,0,0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding IsNormalMode}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShoppingListItemViewModel">
                        <Grid Padding="12,4">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="{Binding Emoji}"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold" />
                                        <Label Text="{Binding QuantityLine}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="6"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="&#xE769;" FontFamily="FluentFilled"
                               FontSize="{StaticResource FontSizeDisplay}" HorizontalOptions="Center"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="Your cart is empty."
                               FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label Text="Ask Sage to add seeds, soil, or tools."
                               FontSize="{StaticResource FontSizeCaption}" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Compact mode: dense rows -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding ShoppingList}"
                            SelectionMode="None"
                            Margin="0,4,0,0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding IsCompactMode}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShoppingListItemViewModel">
                        <Grid Padding="14,2">
                            <Label FontSize="{StaticResource FontSizeBody}" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Emoji}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding Name}" FontAttributes="Bold" />
                                        <Span Text="{Binding QuantityLine, StringFormat=' — {0}'}"
                                              FontSize="{StaticResource FontSizeCaption}"
                                              TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Cart is empty."
                           FontSize="{StaticResource FontSizeCaption}" FontAttributes="Italic"
                           Padding="14,8"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Checkout footer — hidden when cart is empty -->
            <Border Grid.Row="2"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="12,10"
                    IsVisible="{Binding HasCartItems}">
                <Button HorizontalOptions="Fill"
                        Text="{Binding ShoppingListTotal, StringFormat='Checkout — {0}'}"
                        FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold"
                        Padding="16,8"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="10"
                        Command="{Binding CheckoutCartCommand}" />
            </Border>
        </Grid>
    </Border>

</ContentView>
