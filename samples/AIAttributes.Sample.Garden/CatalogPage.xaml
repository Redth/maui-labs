<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.CatalogPage"
             x:DataType="vm:MainViewModel"
             Title="Catalog"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#E0EBDD, Dark=#15201A}">

    <Grid RowDefinitions="56,*">
        <!-- Modal header with close button -->
        <Border Grid.Row="0"
                BackgroundColor="#5B8C5A"
                StrokeThickness="0"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="✕"
                        FontSize="18"
                        Padding="8,4"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        VerticalOptions="Center"
                        Clicked="OnCloseClicked" />
                <Label Grid.Column="1"
                       Text="Product Catalog"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CatalogProducts}"
                        SelectionMode="None"
                        Margin="8,8">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="8"
                                 VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:CatalogGroupViewModel">
                    <Label Text="{Binding CategoryName}"
                           FontSize="16" FontAttributes="Bold"
                           Padding="8,12,8,4"
                           TextColor="{AppThemeBinding Light=#3A5A3A, Dark=#B4D4B4}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogItemViewModel">
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#243024}"
                            Stroke="{AppThemeBinding Light=#D5E5D2, Dark=#3A4A38}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,10">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="{Binding Emoji}"
                                   FontSize="28"
                                   HorizontalOptions="Center" />
                            <Label Grid.Row="1"
                                   Text="{Binding Name}"
                                   FontSize="13" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Row="2"
                                   Text="{Binding PriceLabel}"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#5A6A5A, Dark=#8AA08A}" />
                            <Button Grid.Row="3"
                                    Text="Add to Cart"
                                    FontSize="11"
                                    Padding="8,4"
                                    HeightRequest="30"
                                    BackgroundColor="#5B8C5A"
                                    TextColor="White"
                                    CornerRadius="6"
                                    HorizontalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=AddFromCatalogCommand}"
                                    CommandParameter="{Binding Sku}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
