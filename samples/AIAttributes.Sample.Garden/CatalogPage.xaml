<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.CatalogPage"
             x:DataType="vm:MainViewModel"
             Title="Catalog"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        <!-- Modal header with close button -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="16,8"
                SafeAreaEdges="Container">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="&#xF36A;"
                        FontFamily="FluentFilled"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        Padding="8,4"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        VerticalOptions="Center"
                        Clicked="OnCloseClicked" />
                <Label Grid.Column="1"
                       Text="Product Catalog"
                       FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Grouped catalog with section headers -->
        <ScrollView Grid.Row="1" Padding="8,8">
            <VerticalStackLayout Spacing="16"
                                 MaximumWidthRequest="900"
                                 HorizontalOptions="Center">
                <BindableLayout.ItemsSource>
                    <Binding Path="CatalogGroups" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogGroupViewModel">
                        <VerticalStackLayout Spacing="8">
                            <!-- Category header -->
                            <Label Text="{Binding CategoryName}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontAttributes="Bold"
                                   Padding="8,8,8,0"
                                   TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />

                            <!-- Product cards in a flowing grid -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding}"
                                        Wrap="Wrap"
                                        JustifyContent="Start"
                                        AlignItems="Start"
                                        AlignContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogItemViewModel">
                                        <Border Margin="4"
                                                FlexLayout.Basis="150"
                                                FlexLayout.Grow="1"
                                                MinimumWidthRequest="140"
                                                MaximumWidthRequest="220"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="14,12">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                                <!-- Top row: emoji + name side by side -->
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Label Text="{Binding Emoji}"
                                                           FontSize="32"
                                                           VerticalOptions="Center" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold"
                                                           VerticalOptions="Center"
                                                           LineBreakMode="WordWrap" />
                                                </Grid>
                                                <!-- Bottom row: price + button -->
                                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <Label Text="{Binding PriceLabel}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                                    <Button Grid.Column="1"
                                                            Text="Add"
                                                            FontSize="{StaticResource FontSizeCaption}"
                                                            Padding="10,4"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            TextColor="{StaticResource White}"
                                                            CornerRadius="8"
                                                            VerticalOptions="Center"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=AddFromCatalogCommand}"
                                                            CommandParameter="{Binding Sku}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
