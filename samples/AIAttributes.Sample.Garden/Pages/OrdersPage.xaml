<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Pages.OrdersPage"
             x:DataType="vm:MainViewModel"
             Title="Past Orders"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">
        <!-- Standard header: [back] [icon] [title] ... [clear all] -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="16,8"
                SafeAreaEdges="Container">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Button Text="&#xF36A;"
                            FontFamily="FluentFilled"
                            FontSize="{StaticResource FontSizeSubtitle}"
                            Padding="8,4"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource White}"
                            VerticalOptions="Center"
                            Clicked="OnCloseClicked" />
                    <Label Text="&#xEA07;"
                           FontFamily="FluentFilled"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           TextColor="{StaticResource White}" VerticalOptions="Center" />
                    <Label Text="Orders"
                           FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Grid.Column="1"
                        Text="Clear All"
                        FontSize="{StaticResource FontSizeBody}"
                        FontAttributes="Bold"
                        Padding="12,4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PillBackgroundLight}, Dark={StaticResource PillBackgroundDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource TextAccentDark}}"
                        CornerRadius="14"
                        VerticalOptions="Center"
                        Command="{Binding ClearPastOrdersCommand}" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding PastOrders}"
                        SelectionMode="None"
                        BackgroundColor="Transparent">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="6"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="&#xE1D0;" FontFamily="FluentFilled"
                           FontSize="{StaticResource FontSizeDisplay}" HorizontalOptions="Center"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="No past orders yet."
                           FontSize="{StaticResource FontSizeBody}" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="Check out a list to see it here."
                           FontSize="{StaticResource FontSizeCaption}" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:OrderViewModel">
                    <Border Margin="12,6"
                            MaximumWidthRequest="600"
                            HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="8">
                            <!-- Date header -->
                            <Label Text="{Binding PlacedAt}"
                                   FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold" />

                            <!-- Line items as data grid rows -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OrderLineViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding ItemDescription}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding SubtotalLabel}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   HorizontalTextAlignment="End"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Divider -->
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />

                            <!-- Total + Reorder -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Total, StringFormat='Total: {0}'}"
                                       FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                                <Button Grid.Column="1"
                                        Text="Reorder"
                                        FontSize="{StaticResource FontSizeBody}"
                                        Padding="16,6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource SurfaceDark}}"
                                        TextColor="{StaticResource White}"
                                        CornerRadius="8"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ReorderPastOrderCommand}"
                                        CommandParameter="{Binding OrderId}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
