<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Pages.CatalogPage"
             x:DataType="vm:MainViewModel"
             Title="Catalog"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{StaticResource Primary}">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">
        <!-- Standard header: [back] [icon] [title] -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="16,8"
                SafeAreaEdges="Container">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Button Text="&#xF36A;"
                        FontFamily="FluentFilled"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        Padding="8,4"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        VerticalOptions="Center"
                        Clicked="OnCloseClicked" />
                <Label Text="&#xF788;"
                       FontFamily="FluentFilled"
                       FontSize="{StaticResource FontSizeSubtitle}"
                       TextColor="{StaticResource White}" VerticalOptions="Center" />
                <Label Text="Catalog"
                       FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Grouped vertical product list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CatalogGroups}"
                        IsGrouped="True"
                        BackgroundColor="Transparent">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:CatalogGroupViewModel">
                    <Label Text="{Binding CategoryName}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontAttributes="Bold"
                           Padding="16,16,16,6"
                           TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogItemViewModel">
                    <Border Margin="12,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                            <!-- Hero icon (placeholder — replace with product photo later) -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="64" HeightRequest="64"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding Emoji}"
                                       FontFamily="FluentFilled"
                                       FontSize="32"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <!-- Right side: name on top, price + Add on bottom -->
                            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="4">
                                <Label Text="{Binding Name}"
                                       FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                                       VerticalOptions="End"
                                       LineBreakMode="WordWrap" />
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding PriceLabel}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Button Grid.Column="1"
                                            Text="Add to Cart"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Padding="12,6"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="{StaticResource White}"
                                            CornerRadius="8"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=AddFromCatalogCommand}"
                                            CommandParameter="{Binding Sku}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
