<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AIAttributes.Sample.Garden"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Views.ChatView"
             x:Name="ThisView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="#5B8C5A"
                Padding="16,14"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="🌿 Garden AI"
                       FontSize="20" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="New Chat"
                        AutomationId="NewChatButton"
                        Command="{Binding NewChatCommand}"
                        BackgroundColor="#E3F2E3"
                        TextColor="#5B8C5A"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        Padding="12,6"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Chat messages -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesView"
                        AutomationId="MessagesView"
                        ItemsSource="{Binding Messages}"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <local:ChatMessageTemplateSelector>
                    <local:ChatMessageTemplateSelector.UserTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Border BackgroundColor="#DCF8C6"
                                    Padding="12,8"
                                    Margin="12,0"
                                    HorizontalOptions="End"
                                    MaximumWidthRequest="320"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding Text}"
                                       FontSize="14"
                                       TextColor="Black" />
                            </Border>
                        </DataTemplate>
                    </local:ChatMessageTemplateSelector.UserTemplate>

                    <local:ChatMessageTemplateSelector.AssistantTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Border BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}"
                                    Padding="12,8"
                                    Margin="12,0"
                                    HorizontalOptions="Start"
                                    MaximumWidthRequest="320"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding Text}" FontSize="14" />
                            </Border>
                        </DataTemplate>
                    </local:ChatMessageTemplateSelector.AssistantTemplate>

                    <local:ChatMessageTemplateSelector.ToolTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Label Text="{Binding Text}"
                                   FontSize="12"
                                   TextColor="Gray"
                                   FontAttributes="Italic"
                                   Padding="20,2" />
                        </DataTemplate>
                    </local:ChatMessageTemplateSelector.ToolTemplate>

                    <local:ChatMessageTemplateSelector.SystemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Label Text="{Binding Text}"
                                   FontSize="12"
                                   TextColor="#5B8C5A"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   Padding="8,4" />
                        </DataTemplate>
                    </local:ChatMessageTemplateSelector.SystemTemplate>

                    <local:ChatMessageTemplateSelector.ErrorTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Label Text="{Binding Text}"
                                   FontSize="12"
                                   TextColor="Red"
                                   Padding="20,2" />
                        </DataTemplate>
                    </local:ChatMessageTemplateSelector.ErrorTemplate>
                </local:ChatMessageTemplateSelector>
            </CollectionView.ItemTemplate>

            <!--
                 Empty view shown when a fresh session has no messages yet.
                 Welcomes the user and lists the tools registered in DI.
            -->
            <CollectionView.EmptyView>
                <ScrollView>
                    <VerticalStackLayout Padding="24" Spacing="16"
                                         HorizontalOptions="Center">
                        <Label Text="🌿"
                               FontSize="56"
                               HorizontalOptions="Center" />
                        <Label Text="Welcome to your new garden"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#3A5A3A, Dark=#B4D4B4}" />
                        <Label Text="Ask about plants, build your garden, or request care guides. The assistant can use these tools:"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="380"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#5A6A5A, Dark=#8AA08A}" />

                        <!--
                            BindableLayout instead of a nested CollectionView.
                            A fixed-height CollectionView inside a ScrollView
                            clips the last item and its scrollbar is awkward;
                            BindableLayout lets every row flow naturally and
                            scroll with the outer ScrollView.
                        -->
                        <VerticalStackLayout WidthRequest="420"
                                             Spacing="4"
                                             BindableLayout.ItemsSource="{Binding AvailableTools}"
                                             AutomationId="ToolList">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolInfoViewModel">
                                    <Border Padding="12,8"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#263026}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light=#3A5A3A, Dark=#B4D4B4}" />
                                            <Label Text="{Binding Description}"
                                                   FontSize="12"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Input area -->
        <Grid Grid.Row="2"
              Padding="12,8,12,12"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              IsVisible="{Binding IsInputVisible}"
              BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">
            <Entry AutomationId="ChatInput"
                   Text="{Binding InputText}"
                   IsEnabled="{Binding IsNotBusy}"
                   Placeholder="Ask about plants..."
                   ReturnType="Send"
                   ReturnCommand="{Binding SendCommand}"
                   FontSize="14" />
            <Button Grid.Column="1"
                    Text="Send"
                    AutomationId="SendButton"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#5B8C5A"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="8"
                    Padding="16,8"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Approval area -->
        <Grid Grid.Row="2"
              Padding="12,8,12,12"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8"
              IsVisible="{Binding IsApprovalPending}"
              BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3E3520}">
            <Label Text="{Binding ApprovalText}"
                   FontSize="14"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Button Grid.Column="1"
                    Text="✅ Approve"
                    AutomationId="ApproveButton"
                    Command="{Binding ApproveCommand}"
                    BackgroundColor="#5B8C5A"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="8"
                    Padding="16,8"
                    VerticalOptions="Center" />
            <Button Grid.Column="2"
                    Text="❌ Reject"
                    AutomationId="RejectButton"
                    Command="{Binding RejectCommand}"
                    BackgroundColor="#C62828"
                    TextColor="White"
                    FontSize="14"
                    CornerRadius="8"
                    Padding="16,8"
                    VerticalOptions="Center" />
        </Grid>

    </Grid>

</ContentView>
