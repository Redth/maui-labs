<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIAttributes.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Garden AI Chat"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#FAFAF5, Dark=#1A1A18}">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <!-- Living cart strip at the top — morphs height based on CartMode -->
        <views:CartStripView Grid.Row="0" />

        <!-- Chat fills below, centered on wide screens -->
        <views:ChatView Grid.Row="1"
                        HorizontalOptions="Fill"
                        MaximumWidthRequest="840" />
    </Grid>

</ContentPage>
