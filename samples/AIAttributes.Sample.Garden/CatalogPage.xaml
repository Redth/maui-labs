<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.CatalogPage"
             x:DataType="vm:MainViewModel"
             Title="Catalog"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">

    <Grid RowDefinitions="56,*">
        <!-- Modal header with close button -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="✕"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        Padding="8,4"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        VerticalOptions="Center"
                        Clicked="OnCloseClicked" />
                <Label Grid.Column="1"
                       Text="Product Catalog"
                       FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Flowing product grid -->
        <ScrollView Grid.Row="1" Padding="8,8">
            <FlexLayout BindableLayout.ItemsSource="{Binding CatalogProducts}"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        AlignItems="Start"
                        AlignContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogItemViewModel">
                        <Border Margin="4"
                                WidthRequest="160"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,10">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                <Label Text="{Binding Emoji}"
                                       FontSize="{StaticResource FontSizeDisplay}"
                                       HorizontalOptions="Center" />
                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2"
                                       Text="{Binding PriceLabel}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Button Grid.Row="3"
                                        Text="Add to Cart"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Padding="8,4"
                                        HeightRequest="32"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="{StaticResource White}"
                                        CornerRadius="6"
                                        HorizontalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=AddFromCatalogCommand}"
                                        CommandParameter="{Binding Sku}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>
    </Grid>

</ContentPage>
