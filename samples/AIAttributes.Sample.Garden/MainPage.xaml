<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIAttributes.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Garden AI Chat"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" ColumnSpacing="0" RowSpacing="0"
          SafeAreaEdges="None">

        <!-- ═══ Green header background — spans both columns ═══ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0" />

        <!-- Header content — two-column system: chat area (2*) and cart/button area (1*) -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2"
              ColumnDefinitions="2*,1*"
              Padding="16,8" ColumnSpacing="12"
              SafeAreaEdges="Container">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="Sage"
                       FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}" VerticalOptions="Center" />
                <Label Text="&#xE76C;"
                       FontFamily="FluentFilled"
                       FontSize="{StaticResource FontSizeDisplay}"
                       TextColor="{StaticResource White}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8"
                                   HorizontalOptions="End" VerticalOptions="Center">
                <!-- Cart button — visible only on narrow when sidebar is hidden -->
                <Button x:Name="CartHeaderBtn"
                        Text="&#xF26B;"
                        FontFamily="FluentFilled"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        TextColor="{StaticResource White}"
                        BackgroundColor="Transparent"
                        Padding="8,4"
                        VerticalOptions="Center"
                        Command="{Binding ShowCartCommand}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="CartBtnWide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="800" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="IsVisible" Value="False" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="CartBtnNarrow">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="IsVisible" Value="True" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Button>
                <Button Text="New Chat"
                        AutomationId="NewChatButton"
                        Command="{Binding StartNewSessionCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PillBackgroundLight}, Dark={StaticResource PillBackgroundDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource TextAccentDark}}"
                        FontSize="{StaticResource FontSizeBody}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Padding="12,4"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ═══ Chat — fills col 0, scrollbar at edge, content centered ═══ -->
        <views:ChatView Grid.Row="1" Grid.Column="0"
                        HorizontalOptions="Fill" />

        <!-- ═══ Cart sidebar — col 1, visible on wide only ═══ -->
        <views:ShoppingListView Grid.Row="1" Grid.Column="1"
                                x:Name="CartSidebar"
                                WidthRequest="300"
                                Margin="0,12,12,12">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="SidebarWide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="800" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="IsVisible" Value="True" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SidebarNarrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="IsVisible" Value="False" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </views:ShoppingListView>

    </Grid>

</ContentPage>
