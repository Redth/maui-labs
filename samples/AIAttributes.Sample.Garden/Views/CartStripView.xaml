<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Views.CartStripView"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#5B8C5A">

    <Grid>

        <!-- ═══ COLLAPSED: pill bar ═══ -->
        <Border IsVisible="{Binding IsCollapsedMode}"
                HeightRequest="56"
                BackgroundColor="#5B8C5A"
                StrokeThickness="0"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                <Label Text="🛒"
                       FontSize="20"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding CartSummary}"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Button Grid.Column="3"
                        Text="Checkout →"
                        FontSize="12"
                        Padding="14,6"
                        BackgroundColor="#4A7A4A"
                        TextColor="White"
                        CornerRadius="6"
                        VerticalOptions="Center"
                        Command="{Binding CheckoutCartCommand}" />
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CycleCartModeCommand}" />
            </Border.GestureRecognizers>
        </Border>

        <!-- ═══ COMPACT: single row with horizontal scroll ═══ -->
        <Grid IsVisible="{Binding IsCompactMode}"
              HeightRequest="96"
              RowDefinitions="Auto,*"
              BackgroundColor="#5B8C5A"
              Padding="0">

            <!-- Header row -->
            <Grid Padding="16,8,16,0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Label Text="🛒 Cart"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding CartSummary}"
                       FontSize="12"
                       TextColor="#D4E8D2"
                       VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="{Binding CartModeLabel}"
                        FontSize="10" Padding="8,2" HeightRequest="26"
                        BackgroundColor="#4A7A4A" TextColor="White" CornerRadius="4"
                        VerticalOptions="Center"
                        Command="{Binding CycleCartModeCommand}" />
                <Button Grid.Column="3"
                        Text="Checkout →"
                        FontSize="10" Padding="8,2" HeightRequest="26"
                        BackgroundColor="#3A5A3A" TextColor="White" CornerRadius="4"
                        VerticalOptions="Center"
                        Command="{Binding CheckoutCartCommand}" />
            </Grid>

            <!-- Horizontal scroll of compact items -->
            <ScrollView Grid.Row="1" Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="12,4,12,8">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ShoppingList}"
                                       Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShoppingListItemViewModel">
                            <Border BackgroundColor="#4A7A4A"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="8,4">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Emoji}" FontSize="14" VerticalOptions="Center" />
                                    <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold"
                                           TextColor="White" VerticalOptions="Center"
                                           MaximumWidthRequest="100" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding QuantityLine}" FontSize="10"
                                           TextColor="#D4E8D2" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Empty state -->
            <Label Grid.Row="1"
                   Text="Cart is empty — ask Sage to add some items!"
                   FontSize="11" FontAttributes="Italic"
                   TextColor="#B4D4B4" Padding="16,8" />
        </Grid>

        <!-- ═══ NORMAL: full cards in horizontal scroll ═══ -->
        <Grid IsVisible="{Binding IsNormalMode}"
              HeightRequest="220"
              RowDefinitions="Auto,*,Auto"
              BackgroundColor="#5B8C5A"
              Padding="0">

            <!-- Header row -->
            <Grid Padding="16,10,16,0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Label Text="🛒 Cart"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding CartSummary}"
                       FontSize="13"
                       TextColor="#D4E8D2"
                       VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="{Binding CartModeLabel}"
                        FontSize="10" Padding="8,2" HeightRequest="26"
                        BackgroundColor="#4A7A4A" TextColor="White" CornerRadius="4"
                        VerticalOptions="Center"
                        Command="{Binding CycleCartModeCommand}" />
                <Button Grid.Column="3"
                        Text="{Binding ShoppingListTotal, StringFormat='Checkout — {0}'}"
                        FontSize="11" Padding="10,4" HeightRequest="28"
                        BackgroundColor="#3A5A3A" TextColor="White" CornerRadius="6"
                        VerticalOptions="Center"
                        Command="{Binding CheckoutCartCommand}" />
            </Grid>

            <!-- Horizontal scroll of product cards -->
            <ScrollView Grid.Row="1" Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="12,8,12,10">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ShoppingList}"
                                       Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShoppingListItemViewModel">
                            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#243024}"
                                    Stroke="{AppThemeBinding Light=#D5E5D2, Dark=#3A4A38}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,10"
                                    WidthRequest="160">
                                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Emoji}"
                                           FontSize="28"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding Name}"
                                           FontSize="13" FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding QuantityLine}"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#5A6A5A, Dark=#8AA08A}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Empty state -->
            <VerticalStackLayout Grid.Row="1"
                                 Padding="24" Spacing="4"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="🌱"
                       FontSize="32"
                       HorizontalOptions="Center" />
                <Label Text="Your cart is empty."
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="#D4E8D2" />
                <Label Text="Ask Sage to add seeds, soil, or tools."
                       FontSize="11"
                       HorizontalTextAlignment="Center"
                       TextColor="#B4D4B4" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentView>
