<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.CatalogPage"
             x:DataType="vm:MainViewModel"
             Title="Catalog"
             Shell.PresentationMode="ModalAnimated"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        <!-- Modal header with close button -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="16,8"
                SafeAreaEdges="Container">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="&#xF36A;"
                        FontFamily="FluentFilled"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        Padding="8,4"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        VerticalOptions="Center"
                        Clicked="OnCloseClicked" />
                <Label Grid.Column="1"
                       Text="Product Catalog"
                       FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Grouped catalog with uniform grid items -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CatalogGroups}"
                        IsGrouped="True"
                        BackgroundColor="Transparent">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="8"
                                 VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:CatalogGroupViewModel">
                    <Label Text="{Binding CategoryName}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontAttributes="Bold"
                           Padding="12,16,12,4"
                           TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogItemViewModel">
                    <Border Margin="4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,12">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <!-- Icon -->
                            <Label Text="{Binding Emoji}"
                                   FontFamily="FluentFilled"
                                   FontSize="36"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                            <!-- Name -->
                            <Label Grid.Row="1"
                                   Text="{Binding Name}"
                                   FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                            <!-- Price + Add -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label Text="{Binding PriceLabel}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Button Grid.Column="1"
                                        Text="Add"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Padding="12,6"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="{StaticResource White}"
                                        CornerRadius="8"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=AddFromCatalogCommand}"
                                        CommandParameter="{Binding Sku}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
