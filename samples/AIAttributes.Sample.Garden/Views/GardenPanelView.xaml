<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Views.GardenPanelView"
             x:DataType="vm:MainViewModel">

    <!--
         Bound to the scoped GardenService data for the current chat session.
         Clears when New Chat creates a new DI scope, making the scoped-lifetime
         story visible at runtime.
    -->
    <Border WidthRequest="260"
            BackgroundColor="{AppThemeBinding Light=#F0F7EF, Dark=#1A241A}"
            Stroke="{AppThemeBinding Light=#D0E0CF, Dark=#2A3A2A}"
            StrokeThickness="0,0,0,0"
            Padding="0">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    BackgroundColor="#5B8C5A"
                    Padding="14,12"
                    StrokeThickness="0">
                <Label Text="🌱 Your Garden"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold" />
            </Border>
            <CollectionView Grid.Row="1"
                            AutomationId="GardenList"
                            Margin="0,4,0,0"
                            ItemsSource="{Binding GardenPlants}">
                <CollectionView.EmptyView>
                    <Label Text="No plants yet. Ask the assistant to add some."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#7A8A7A, Dark=#8AA08A}"
                           Padding="14,20"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GardenPlantViewModel">
                        <Grid Margin="10,4">
                            <!-- Plant card (ghosts when this plant is pending removal). -->
                            <Border Padding="10,8"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#263026}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Opacity="{Binding IsPendingRemoval, Converter={StaticResource BoolToDimOpacity}}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Emoji}"
                                           FontSize="22"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Nickname}"
                                               FontAttributes="Bold"
                                               FontSize="13" />
                                        <Label Text="{Binding Species}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#5B8C5A, Dark=#8FBF8F}" />
                                        <Label Text="{Binding Location, StringFormat='📍 {0}'}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#888, Dark=#AAA}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <!-- Approval-pending overlay. -->
                            <Border IsVisible="{Binding IsPendingRemoval}"
                                    BackgroundColor="#AAC62828"
                                    StrokeThickness="1"
                                    Stroke="#C62828"
                                    StrokeShape="RoundRectangle 8"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill">
                                <Label Text="🔒 Pending removal"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>

</ContentView>
