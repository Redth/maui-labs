<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIAttributes.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.Pages.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Garden AI Chat"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" ColumnSpacing="0" RowSpacing="0"
          SafeAreaEdges="None">

        <!-- ═══ Green header background — spans both columns ═══ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0" />

        <!-- Header content — standard: [icon] [title] ... [actions] -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2"
              ColumnDefinitions="*,Auto"
              Padding="16,8" ColumnSpacing="8"
              SafeAreaEdges="Container">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="&#xE76C;"
                       FontFamily="FluentFilled"
                       FontSize="{StaticResource FontSizeTitle}"
                       TextColor="{StaticResource White}" VerticalOptions="Center" />
                <Label Text="Sage"
                       FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold"
                       TextColor="{StaticResource White}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8"
                                   HorizontalOptions="End" VerticalOptions="Center">
                <!-- Cart button — visible only on narrow when sidebar is hidden -->
                <Button x:Name="CartHeaderBtn"
                        Text="&#xF26B;"
                        FontFamily="FluentFilled"
                        FontSize="{StaticResource FontSizeTitle}"
                        TextColor="{StaticResource White}"
                        BackgroundColor="Transparent"
                        Padding="8,4"
                        VerticalOptions="Center"
                        Command="{Binding Cart.ShowCommand}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="CartBtnWide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="800" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="IsVisible" Value="False" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="CartBtnNarrow">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="IsVisible" Value="True" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Button>
                <Button Text="New Chat"
                        AutomationId="NewChatButton"
                        Command="{Binding StartNewSessionCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PillBackgroundLight}, Dark={StaticResource PillBackgroundDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource TextAccentDark}}"
                        FontSize="{StaticResource FontSizeBody}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Padding="12,4"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ═══ Chat — fills col 0, scrollbar at edge, content centered ═══ -->
        <views:ChatView Grid.Row="1" Grid.Column="0"
                        BindingContext="{Binding Chat}"
                        HorizontalOptions="Fill" />

        <!-- ═══ Cart sidebar — col 1, visible on wide only ═══ -->
        <Border Grid.Row="1" Grid.Column="1"
                x:Name="CartSidebar"
                WidthRequest="300"
                Margin="0,12,12,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                StrokeShape="RoundRectangle 16"
                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                StrokeThickness="1">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.12" />
            </Border.Shadow>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="SidebarWide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="800" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="IsVisible" Value="True" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SidebarNarrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="IsVisible" Value="False" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid RowDefinitions="Auto,*" RowSpacing="0">
                <!-- Green sidebar header -->
                <Grid Padding="14,10"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8"
                      BackgroundColor="{StaticResource Primary}">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="&#xF26B;"
                               FontFamily="FluentFilled"
                               FontSize="{StaticResource FontSizeBody}"
                               TextColor="{StaticResource White}" VerticalOptions="Center" />
                        <Label Text="Cart"
                               FontSize="{StaticResource FontSizeBody}" FontAttributes="Bold"
                               TextColor="{StaticResource White}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PillBackgroundLight}, Dark={StaticResource PillBackgroundDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 13"
                            Padding="0"
                            HeightRequest="26">
                        <Button Text="{Binding Cart.CartModeLabel}"
                                FontSize="{StaticResource FontSizeCaption}" Padding="14,0"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource TextAccentLight}, Dark={StaticResource TextAccentDark}}"
                                FontAttributes="Bold"
                                BorderWidth="0"
                                VerticalOptions="Center"
                                Command="{Binding Cart.CycleCartModeCommand}" />
                    </Border>
                </Grid>
                <!-- Headerless cart content -->
                <views:ShoppingListView Grid.Row="1" BindingContext="{Binding Cart}" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
