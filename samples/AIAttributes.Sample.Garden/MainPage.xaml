<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AIAttributes.Sample.Garden.Views"
             xmlns:vm="clr-namespace:AIAttributes.Sample.Garden.ViewModels"
             x:Class="AIAttributes.Sample.Garden.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Garden AI Chat"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="*,320" RowDefinitions="2*,*" ColumnSpacing="0" RowSpacing="0">

        <!-- Chat occupies the entire left column -->
        <views:ChatView Grid.Column="0" Grid.RowSpan="2" />

        <!-- Shopping list in top-right -->
        <views:ShoppingListView Grid.Column="1" Grid.Row="0" />

        <!-- Past orders in bottom-right -->
        <views:OrdersView Grid.Column="1" Grid.Row="1" />

    </Grid>

</ContentPage>
